[Unit]
Description=Piholegotchi e-ink screen
After=network-online.target
Wants=network-online.target

[Service]
User=piholegotchi
# lgpio writes small files into the working directory, so it must be writable
WorkingDirectory=/var/lib/piholegotchi
# updates from the settings page land in app/ and take priority over the image copy
Environment=PYTHONPATH=/var/lib/piholegotchi/app:/opt/piholegotchi
Environment=PIHOLEGOTCHI_HOME=/var/lib/piholegotchi
ExecStart=/usr/bin/python3 -m piholegotchi
# lets the settings page use port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
